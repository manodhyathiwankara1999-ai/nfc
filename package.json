{
  "name": "nfc-ecard",
  "private": true,
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:api": "pnpm --filter api dev",
    "start": "turbo run start --filter=@nfc/web",
    "build": "turbo run build",
    "build:cloudflare:web": "pnpm exec turbo run build --filter=@nfc/web && pnpm --filter @nfc/web exec opennextjs-cloudflare build --skipNextBuild",
    "preview:cloudflare:web": "pnpm run build:cloudflare:web && pnpm --filter @nfc/web exec opennextjs-cloudflare preview",
    "deploy:cloudflare:web": "pnpm run build:cloudflare:web && pnpm --filter @nfc/web exec opennextjs-cloudflare deploy",
    "typecheck:cloudflare:api": "pnpm --filter api run typecheck:cloudflare",
    "preview:cloudflare:api": "pnpm --filter api run preview:cloudflare",
    "deploy:cloudflare:api": "pnpm --filter api run deploy:cloudflare",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:responsive": "pnpm --filter @nfc/shared build && playwright test --config=playwright.responsive.config.ts",
    "generate:template": "node apps/web/scripts/create-profile-template.mjs",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "packageManager": "pnpm@9.15.4",
  "devDependencies": {
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.15",
    "eslint-config-prettier": "9.1.0",
    "@typescript-eslint/eslint-plugin": "8.71.0",
    "husky": "9.1.7",
    "lint-staged": "15.2.10",
    "prettier": "3.4.2",
    "@playwright/test": "^1.55.0",
    "turbo": "2.3.3",
    "typescript": "5.6.3",
    "vitest": "2.1.5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
