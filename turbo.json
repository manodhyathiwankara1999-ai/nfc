{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^build", "^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "@nfc/shared#build": {
      "outputs": ["dist/**"]
    },
    "@nfc/web#build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**"],
      "env": ["API_INTERNAL_URL", "NEXT_PUBLIC_*", "NEXT_DIST_DIR"]
    }
  }
}
