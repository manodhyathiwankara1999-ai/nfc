# Supabase PostgreSQL URLs; see docs/study-guide/03-config-and-env.md.
DATABASE_URL=
DIRECT_URL=

WEB_APP_URL=http://localhost:3000
REVALIDATION_SECRET=
TRUSTED_PROXY_IPS=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Used only by the super-admin seed to create/update the reserved Supabase Auth account.
SUPABASE_SERVICE_ROLE_KEY=
# Used only by the super-admin seed.
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_PASSWORD=
MAX_CARDS_PER_USER=5
CORS_ORIGINS=http://localhost:3000
PORT=4000
NODE_ENV=development

# Optional integrations: configure all R2 values, or leave all of them blank.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
GALLERY_MAX_IMAGES=30
ANALYTICS_RAW_RETENTION_DAYS=365
# Required: independent random value of at least 32 characters for IP hashing.
IP_HASH_SALT=
# Optional; Sentry is not initialized by the current app.
SENTRY_DSN=
