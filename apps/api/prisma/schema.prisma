generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["public"]
}

enum Role {
  USER        @map("user")
  OWNER       @map("owner")
  ADMIN       @map("admin")
  MEMBER      @map("member")
  SUPER_ADMIN @map("super_admin")

  @@schema("public")
}

enum AccountType {
  SELF_EMPLOYED @map("self_employed")
  COMPANY       @map("company")

  @@map("user_account_type")
  @@schema("public")
}

enum ProfileType {
  PERSONAL   @map("personal")
  COMMERCIAL @map("commercial")

  @@map("profile_type")
  @@schema("public")
}

enum CardStatus {
  ACTIVE    @map("active")
  INACTIVE  @map("inactive")
  SUSPENDED @map("suspended")
  LOST      @map("lost")
  DELETED   @map("deleted")

  @@schema("public")
}

enum CardPurpose {
  PERSONAL       @map("personal")
  BUSINESS_OWNER @map("business_owner")
  FREELANCER     @map("freelancer")
  EMPLOYEE       @map("employee")
  DOCTOR         @map("doctor")
  LAWYER         @map("lawyer")
  TEACHER        @map("teacher")
  STUDENT        @map("student")
  REAL_ESTATE    @map("real_estate")
  OTHER          @map("other")

  @@map("card_purpose")
  @@schema("public")
}

enum CardCreator {
  OWNER       @map("owner")
  SUPER_ADMIN @map("super_admin")

  @@map("card_creator")
  @@schema("public")
}

enum ThemeCategory {
  TECHNOLOGY
  HEALTHCARE
  REAL_ESTATE
  LEGAL
  EDUCATION
  FINANCE
  CREATIVE
  HOSPITALITY
  CONSTRUCTION
  RETAIL
  AUTOMOTIVE
  BEAUTY_WELLNESS
  GENERIC

  @@schema("public")
}

enum AnalyticsEventType {
  PROFILE_VIEW
  CARD_TAP
  WIDGET_CLICK

  @@schema("public")
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
  REFUNDED

  @@schema("public")
}

model User {
  id                  String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supabaseUserId      String?                  @unique @map("supabase_user_id") @db.Uuid
  email               String                   @unique @db.VarChar(320)
  name                String?                  @db.VarChar(100)
  phone               String?                  @db.VarChar(16)
  passwordHash        String?                  @map("password_hash")
  passwordHashAlgo    String                   @default("argon2id") @map("password_hash_algo") @db.VarChar(20)
  role                Role                     @default(USER)
  accountType         AccountType              @default(SELF_EMPLOYED) @map("account_type")
  emailVerifiedAt     DateTime?                @map("email_verified_at") @db.Timestamptz(6)
  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?                @map("deleted_at") @db.Timestamptz(6)
  refreshTokens       RefreshToken[]
  emailTokens         EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  oauthAccounts       OAuthAccount[]
  companyMemberships  CompanyMember[]
  orders              Order[]
  auditLogs           AuditLog[]
  assets              Asset[]
  cards               Card[]

  @@index([deletedAt])
  @@map("users")
  @@schema("public")
}

model RefreshToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  familyId   String    @map("family_id") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedBy String?   @map("replaced_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("refresh_tokens")
  @@schema("public")
}

model EmailVerificationToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("email_verification_tokens")
  @@schema("public")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
  @@schema("public")
}

model OAuthAccount {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  provider          String   @db.VarChar(40)
  providerAccountId String   @map("provider_account_id") @db.VarChar(255)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
  @@schema("public")
}

model Company {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String          @db.VarChar(200)
  slug      String          @unique @db.VarChar(80)
  logoUrl   String?         @map("logo_url")
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime?       @map("deleted_at") @db.Timestamptz(6)
  members   CompanyMember[]
  cards     Card[]
  orders    Order[]

  @@index([deletedAt])
  @@map("companies")
  @@schema("public")
}

model CompanyMember {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([userId, role])
  @@map("company_members")
  @@schema("public")
}

model Card {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId     String?          @map("profile_id") @db.Uuid
  companyId     String?          @map("company_id") @db.Uuid
  ownerId       String?          @map("owner_id") @db.Uuid
  slug          String           @unique @db.VarChar(100)
  claimCodeHash String?          @unique @map("claim_code_hash") @db.Char(64)
  label         String?          @db.VarChar(100)
  status        CardStatus       @default(INACTIVE)
  purpose       CardPurpose      @default(PERSONAL)
  customPurpose String?          @map("custom_purpose") @db.VarChar(80)
  createdBy     CardCreator      @default(OWNER) @map("created_by")
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  revokedAt     DateTime?        @map("revoked_at") @db.Timestamptz(6)
  deletedAt     DateTime?        @map("deleted_at") @db.Timestamptz(6)
  profile       Profile?         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  company       Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  owner         User?            @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  cardProfile   CardProfile?
  events        AnalyticsEvent[]
  auditLogs     AuditLog[]

  @@index([profileId, status])
  @@index([companyId])
  @@index([ownerId, deletedAt])
  @@index([status, deletedAt])
  @@map("cards")
  @@schema("public")
}

model CardProfile {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cardId       String        @unique @map("card_id") @db.Uuid
  fullName     String        @map("full_name") @db.VarChar(100)
  jobTitle     String?       @map("job_title") @db.VarChar(100)
  skillsLine   String?       @map("skills_line") @db.VarChar(120)
  tagline      String?       @db.VarChar(120)
  avatar       String?
  cover        String?
  contact      Json          @default("{}") @db.JsonB
  socialLinks  Json          @default("[]") @map("social_links") @db.JsonB
  themeColor   String        @default("#4f46e5") @map("theme_color") @db.VarChar(7)
  templateId   String?       @map("template_id") @db.VarChar(40)
  gallery      Json          @default("[]") @db.JsonB
  showProducts Boolean       @default(false) @map("show_products")
  isPublic     Boolean       @default(true) @map("is_public")
  isIndexable  Boolean       @default(true) @map("is_indexable")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  card         Card          @relation(fields: [cardId], references: [id], onDelete: Restrict)
  office       CardOffice?
  products     CardProduct[]

  @@map("card_profiles")
  @@schema("public")
}

model CardOffice {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cardProfileId  String      @unique @map("card_profile_id") @db.Uuid
  hasOffice      Boolean     @default(false) @map("has_office")
  companyName    String?     @map("company_name") @db.VarChar(160)
  designation    String?     @db.VarChar(100)
  department     String?     @db.VarChar(100)
  officeAddress  String?     @map("office_address") @db.VarChar(500)
  officePhone    String?     @map("office_phone") @db.VarChar(16)
  officeEmail    String?     @map("office_email") @db.VarChar(254)
  companyWebsite String?     @map("company_website")
  workingHours   String?     @map("working_hours") @db.VarChar(160)
  cardProfile    CardProfile @relation(fields: [cardProfileId], references: [id], onDelete: Restrict)

  @@map("card_offices")
  @@schema("public")
}

model CardProduct {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cardProfileId String      @map("card_profile_id") @db.Uuid
  image         String
  name          String      @db.VarChar(100)
  price         Decimal?    @db.Decimal(12, 2)
  currency      String      @default("USD") @db.Char(3)
  detail        String      @db.VarChar(120)
  sortOrder     Int         @default(0) @map("sort_order")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?   @map("deleted_at") @db.Timestamptz(6)
  cardProfile   CardProfile @relation(fields: [cardProfileId], references: [id], onDelete: Restrict)

  @@index([cardProfileId, deletedAt, sortOrder])
  @@map("card_products")
  @@schema("public")
}

model Profile {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String                @unique @map("user_id") @db.Uuid
  slug           String                @unique
  displayName    String?               @map("display_name")
  title          String?
  bio            String?
  avatarUrl      String?               @map("avatar_url")
  tagline        String?               @db.VarChar(80)
  skillsLine     String?               @map("skills_line") @db.VarChar(120)
  coverImageUrl  String?               @map("cover_image_url")
  phone          String?               @db.VarChar(40)
  email          String?               @db.VarChar(254)
  location       String?               @db.VarChar(100)
  website        String?
  linkedinUrl    String?               @map("linkedin_url")
  githubUrl      String?               @map("github_url")
  themeColor     String                @default("#4f46e5") @map("theme_color") @db.VarChar(7)
  profileType    ProfileType           @default(PERSONAL) @map("profile_type")
  isPublic       Boolean               @default(true) @map("is_public")
  isIndexable    Boolean               @default(true) @map("is_indexable")
  theme          Json                  @default("{\"primary\":\"#4f46e5\",\"secondary\":\"#0f172a\",\"accent\":\"#f59e0b\",\"background\":{\"type\":\"solid\",\"value\":\"#f8fafc\"},\"font\":\"system\"}") @db.JsonB
  contact        Json                  @default("{}") @db.JsonB
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  themeId        String?               @map("theme_id") @db.Uuid
  selectedTheme  Theme?                @relation(fields: [themeId], references: [id], onDelete: SetNull)
  socialLinks    SocialLink[]
  gallery        GalleryImage[]
  cards          Card[]
  events         AnalyticsEvent[]
  slugRedirects  ProfileSlugRedirect[]
  assets         Asset[]
  analyticsDaily AnalyticsDaily[]

  @@index([isPublic, slug])
  @@map("profiles")
  @@schema("public")
}

model ProfileSlugRedirect {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  oldSlug   String   @unique @map("old_slug") @db.VarChar(48)
  newSlug   String   @map("new_slug") @db.VarChar(48)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("profile_slug_redirects")
  @@schema("public")
}

model SocialLink {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  platform  String   @default("website") @db.VarChar(40)
  label     String   @db.VarChar(80)
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, position])
  @@map("social_links")
  @@schema("public")
}

model GalleryImage {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId String    @map("profile_id") @db.Uuid
  assetId   String?   @unique @map("asset_id") @db.Uuid
  objectKey String    @map("object_key")
  caption   String?   @db.VarChar(300)
  altText   String?   @map("alt_text")
  position  Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  asset     Asset?    @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([profileId, position])
  @@index([deletedAt])
  @@map("gallery_images")
  @@schema("public")
}

model Asset {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  profileId    String?       @map("profile_id") @db.Uuid
  kind         String        @db.VarChar(20)
  objectKey    String        @unique @map("object_key")
  contentType  String        @map("content_type") @db.VarChar(80)
  size         Int
  confirmedAt  DateTime?     @map("confirmed_at") @db.Timestamptz(6)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt    DateTime?     @map("deleted_at") @db.Timestamptz(6)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile      Profile?      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  galleryImage GalleryImage?

  @@index([userId, kind, confirmedAt])
  @@index([profileId, kind])
  @@map("assets")
  @@schema("public")
}

model Theme {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key                 String        @unique @db.VarChar(50)
  name                String        @db.VarChar(100)
  category            ThemeCategory @unique
  palette             Json          @db.JsonB
  backgroundConfigKey String        @map("background_config_key") @db.VarChar(80)
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  profiles            Profile[]

  @@map("themes")
  @@schema("public")
}

model AnalyticsEvent {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId    String             @map("profile_id") @db.Uuid
  cardId       String?            @map("card_id") @db.Uuid
  type         AnalyticsEventType
  hashedIp     String?            @map("hashed_ip") @db.Char(64)
  userAgent    String?            @map("user_agent") @db.VarChar(512)
  deviceType   String?            @map("device_type") @db.VarChar(40)
  browser      String?            @db.VarChar(80)
  country      String?            @db.Char(2)
  referrerHost String?            @map("referrer_host") @db.VarChar(255)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  profile      Profile            @relation(fields: [profileId], references: [id], onDelete: Cascade)
  card         Card?              @relation(fields: [cardId], references: [id], onDelete: SetNull)

  @@index([profileId, createdAt])
  @@index([cardId, createdAt])
  @@index([createdAt])
  @@map("analytics_events")
  @@schema("public")
}

model AnalyticsDaily {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId      String   @map("profile_id") @db.Uuid
  day            DateTime @db.Date
  views          Int      @default(0)
  uniqueVisitors Int      @default(0) @map("unique_visitors")
  visitorHashes  String[] @default([]) @map("visitor_hashes") @db.Text
  deviceSplit    Json     @default("{}") @map("device_split") @db.JsonB
  topReferrers   Json     @default("{}") @map("top_referrers") @db.JsonB
  topCountries   Json     @default("{}") @map("top_countries") @db.JsonB
  rolledUpAt     DateTime @default(now()) @map("rolled_up_at") @db.Timestamptz(6)
  profile        Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, day])
  @@index([day])
  @@map("analytics_daily")
  @@schema("public")
}

model Order {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String?     @map("user_id") @db.Uuid
  companyId       String?     @map("company_id") @db.Uuid
  externalOrderId String?     @unique @map("external_order_id") @db.VarChar(120)
  status          OrderStatus @default(PENDING)
  currency        String      @default("USD") @db.Char(3)
  totalMinor      Int         @default(0) @map("total_minor")
  metadata        Json        @default("{}") @db.JsonB
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?   @map("deleted_at") @db.Timestamptz(6)
  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  company         Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([companyId, createdAt])
  @@index([status, createdAt])
  @@map("orders")
  @@schema("public")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  cardId     String?  @map("card_id") @db.Uuid
  action     String   @db.VarChar(120)
  entityType String   @map("entity_type") @db.VarChar(80)
  entityId   String?  @map("entity_id") @db.VarChar(120)
  requestId  String?  @map("request_id") @db.VarChar(64)
  metadata   Json     @default("{}") @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  card       Card?    @relation(fields: [cardId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([cardId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([requestId])
  @@map("audit_logs")
  @@schema("public")
}

model WebhookEvent {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider    String    @db.VarChar(40)
  eventId     String    @map("event_id") @db.VarChar(255)
  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)
  payload     Json      @db.JsonB

  @@unique([provider, eventId])
  @@index([receivedAt])
  @@map("webhook_events")
  @@schema("public")
}
