{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @nfc/shared build && nest start --watch",
    "prebuild": "pnpm run prisma:generate",
    "build": "nest build",
    "start": "node dist/src/main.js",
    "cloudflare:typegen": "wrangler types worker-configuration.d.ts --config wrangler.jsonc",
    "typecheck:cloudflare": "pnpm run cloudflare:typegen && tsc --noEmit -p tsconfig.cloudflare.json",
    "preview:cloudflare": "wrangler dev --config wrangler.jsonc",
    "deploy:cloudflare": "wrangler deploy --config wrangler.jsonc",
    "prelint": "pnpm --filter @nfc/shared build",
    "lint": "eslint \"src/**/*.ts\" \"prisma/**/*.ts\" \"scripts/**/*.ts\" \"cloudflare/**/*.ts\" --max-warnings=0",
    "pretypecheck": "pnpm --filter @nfc/shared build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "pnpm --filter @nfc/shared build",
    "test": "vitest run --passWithNoTests",
    "prisma": "prisma",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:seed": "prisma db seed",
    "migrate:supabase-avatars": "ts-node scripts/migrate-supabase-avatars-to-r2.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@nestjs/common": "10.4.20",
    "@nestjs/config": "3.3.0",
    "@nestjs/core": "10.4.20",
    "@nestjs/platform-express": "10.4.20",
    "@nestjs/swagger": "7.4.2",
    "@nfc/shared": "workspace:^",
    "@prisma/client": "6.19.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "dotenv": "^18.0.5",
    "helmet": "8.0.0",
    "nanoid": "3.3.19",
    "nestjs-pino": "4.1.0",
    "pg": "^8.23.1",
    "pino-http": "10.4.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.9",
    "@nestjs/schematics": "10.2.3",
    "@nestjs/testing": "10.4.20",
    "@types/express": "4.17.21",
    "@types/node": "20.17.10",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "prisma": "6.19.1",
    "supertest": "^7.3.1",
    "ts-node": "10.9.2",
    "typescript": "5.6.3",
    "wrangler": "4.148.0",
    "vitest": "2.1.5"
  }
}
